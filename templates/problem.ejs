<!DOCTYPE html>
<head>
  <title><%= problem.data.name %></title>

  <!-- Load the library via CDN -->
  <script type="module">
    import HighlightedCode from 'https://unpkg.com/highlighted-code';
    HighlightedCode.useTheme('github');
  </script>

  <script>
    // initialise web worker
    // loop through test cases
    // see result
    // for later, add completed 

    function runUserCode() {
      const userCodeString = document.getElementById("userCode").value

      // main.js
// 1. Initialize the background worker thread
      const myWorker = new Worker('/worker.js');

      // 2. Define what to do when the worker sends back data
      myWorker.onmessage = function(event) {
          console.log('Received result from worker:', event.data);
      };

      // 3. Trigger the worker by sending it some data
      const number = 42;
      console.log('Sending number to worker:', number);
      myWorker.postMessage(number);

    }

  </script>
</head>
<body>
  <div>
    <h2><%= problem.data.id %>. <%= problem.data.name %></h2>
    <p>difficulty: <%= problem.data.level %></p>

    <p><%- desc %></p>
  </div>

  <textarea id="userCode" is="highlighted-code" language="javascript" tab-size="2" rows="30" cols="120"><%= solutionTemplate %></textarea>
  <button onclick="runUserCode()">run tests</button>
  <p name="testResult">t</p>
</body>
</html>
