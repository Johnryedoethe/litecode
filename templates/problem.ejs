<!DOCTYPE html>
<head>
  <title><%= problem.data.slugname %></title>

  <!-- Load the library via CDN -->
  <script type="module">
    import HighlightedCode from 'https://unpkg.com/highlighted-code';
    HighlightedCode.useTheme('github');
  </script>

  <script>
    function runUserCode() {
      const userFuncBody = document.getElementById("userCode").value
      let timer = null

      // 1. Initialize the worker thread
      const webWorker = new Worker('/worker.js');

      // 2. Define what to do when the worker sends back data
      webWorker.onmessage = function(event) {
          console.log('Received result from worker:', event.data);

          watchdogTimer("stop")
          handleResult(event)
          webWorker.terminate()
      };

      // 3. run worker by sending it the test cases
      // when stringifying the red is an ejs and html script issue that doesn't cause impact anything
      const testcases = <%- JSON.stringify(problem.data.testcases) %>
      webWorker.postMessage({testcases, userFuncBody});
      watchdogTimer("start")
     

      function watchdogTimer(status) {
        if (status === "stop") {
          clearTimeout(timer)
        }

        if (status === "start") {
          timer = setTimeout(() => {
            const msg = "algorithm is too slow or is frozen"
            handleResult({data: {status: JSON.stringify(msg)}})
            webWorker.terminate()
          }, 4000)
        }
       
      }

      function handleResult(workerData) {
        let userLoggedIn = true
        const { status, result, err } = workerData.data

        let testRes = document.getElementById("testResult")
        
        if (userLoggedIn) {
          handlePostReq(workerData.data)
        }

        if (status === "algorithm is too slow or is frozen") {
          testRes.textContent = `result: ${status}`
          
        }

        if (status === "Error found") {
          testRes.textContent = `result: ${status}, ${err}`
        }

        if (status === "Failed") {
          testRes.textContent = `${result.casesPassed} cases passed, Input: ${result.input}, Output: ${result.output}, expected: ${result.expected}`
        }

        if (status === "Complete") {
          testRes.textContent = `${result}`
        }
      }

      async function handlePostReq(body) {
        // get user id
        const { status } = body
        const infoBody = {status: status, userSolution: userFuncBody, solutionId: <%= problem.data.id %>, userId: "1"}
        
        try {
          const writeSolutionRes = await fetch('/createOrUpdateSolution', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(infoBody)
          })

          const res = await writeSolutionRes.json()
          
          console.log(res)
          if (!res.ok) {
            throw new Error(res.message)
          }
        } catch(err) {
          console.log(err.message)
        }
      }
    }

  </script>
</head>
<body>
  <div>
    <% if (completed !== false) { %>
      <p>completed<p></p> 
    <% } %>
    <h2><%= problem.data.id %>. <%= problem.data.name %></h2>
    <p>difficulty: <%= problem.data.level %></p>

    <p><%- desc %></p>
  </div>

  <textarea id="userCode" is="highlighted-code" language="javascript" tab-size="2" rows="30" cols="120"><%= solutionTemplate %></textarea>
  <button onclick="runUserCode()">run tests</button>
  <div><p id="testResult"></p></div>
</body>
</html>
