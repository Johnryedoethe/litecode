<!DOCTYPE html>
<head>
  <title><%= problem.data.name %></title>

  <!-- Load the library via CDN -->
  <script type="module">
    import HighlightedCode from 'https://unpkg.com/highlighted-code';
    HighlightedCode.useTheme('github');
  </script>
</head>
<body>
  <div>
    <h2><%= problem.data.id %>. <%= problem.data.name %></h2>
    <p><%= problem.data.level %></p>

    <p><%- desc %></p>
  </div>

  <textarea is="highlighted-code" language="javascript" tab-size="2" rows="30" cols="120"><%= solutionTemplate %></textarea>
</body>
</html>
