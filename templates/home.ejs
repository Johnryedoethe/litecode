<!DOCTYPE html>
<head>
  <title>problemset</title>
</head>
<body>
  <div>
    <h2>problemSet</h2>

    <% problems.forEach((problem) => { %>
      <div>
        <a href="/problems/<%= problem.data.id %>/<%= problem.data.name %>">
          <%= problem.data.name %>
        </a>
      </div>
    <% }) %>
  </div>
    
</body>
</html>
